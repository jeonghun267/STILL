--- !u!114 &449036353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 449036352}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f679c258d6c46bd41a833b4952e33b28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TurtleNightStory
  title: "\uBC14\uB2E4\uAC70\uBD81\uC758 \uBC24"
  spot: {fileID: 1816024602}
  nolant: {fileID: 1078828334}
  nolantSpot: {fileID: 1458934216}
  deviceLight: {fileID: 945395705}
  nest: {fileID: 225231883}
  shells:
  - {fileID: 412376252}
  - {fileID: 1391539814}
  - {fileID: 1067576979}
  - {fileID: 952348519}
  - {fileID: 1116805067}
  - {fileID: 988478179}
  - {fileID: 2109688671}
  hatchlings:
  - {fileID: 78789254}
  - {fileID: 569671942}
  - {fileID: 1733426728}
  - {fileID: 1027743233}
  - {fileID: 587254883}
  - {fileID: 1281445977}
  - {fileID: 528000546}
  - {fileID: 1476971145}
  - {fileID: 1352135470}
  - {fileID: 1828186042}
  - {fileID: 1731465337}
  - {fileID: 292760708}
  ground: {fileID: 777388095}
  seaDirection: {x: 1, y: 0, z: 0}
  seaY: 22.8
  crawlSpeed: 0.17
  confusedSpeed: 0.08
  emergeGap: 0.7
  giveUpSeconds: 45
  sand: {fileID: 0}
  sandClip: {fileID: 0}
  hushLine: "\uC27F\u2026 \uC774\uB9AC \uC640 \uBD10. \uC5EC\uAE30 \uBAA8\uB798 \uBC11\uC5D0
    \uBC14\uB2E4\uAC70\uBD81 \uC54C\uC774 \uBB3B\uD600 \uC788\uC5B4. \uC624\uB298
    \uBC24 \uAE68\uC5B4\uB0A0 \uAC70\uC57C!"
  lightLine: "\uADF8\uB7F0\uB370 \uB124 \uAD00\uCC30\uAE30 \uC870\uBA85\uC774 \uCF1C\uC838
    \uC788\uB124. \uC0C8\uB07C \uAC70\uBD81\uC740 \uB2EC\uBE5B\uC774 \uBE44\uCE5C
    \uBC14\uB2E4 \uCABD\uC73C\uB85C \uAE30\uC5B4\uAC00\uB294\uB370, \uBD88\uBE5B\uC774
    \uC788\uC73C\uBA74 \uADF8\uCABD\uC744 \uBC14\uB2E4\uB85C \uCC29\uAC01\uD574.
    A \uBC84\uD2BC\uC774\uB098 X \uBC84\uD2BC\uC73C\uB85C \uC870\uBA85\uC744 \uAEBC
    \uC904\uB798?"
  offLine: "\uACE0\uB9C8\uC6CC. \uC774\uC81C \uAC00\uB9CC\uD788 \uC9C0\uCF1C\uBCF4\uC790\u2026"
  helpLine: "\uAD1C\uCC2E\uC544, \uB0B4\uAC00 \uAEBC \uC904\uAC8C."
  hatchLine: "\uBD10, \uBAA8\uB798\uAC00 \uC6C0\uC9C1\uC5EC! \uB098\uC628\uB2E4!"
  strayLine: "\uC557, \uBD88\uBE5B \uCABD\uC73C\uB85C \uC624\uC796\uC544! \uC870\uBA85\uC744
    \uAEBC \uC918!"
  doneLine: "\uB2E4 \uBC14\uB2E4\uC5D0 \uB2FF\uC558\uC5B4! \uACE0\uB9C8\uC6CC. \uC5B8\uC820\uAC00
    \uC774 \uC544\uC774\uB4E4\uB3C4 \uC800 \uBC14\uB2E4\uB97C \uAC74\uB108, \uC5B4\uB978\uC774
    \uB418\uBA74 \uC774 \uD574\uBCC0\uC73C\uB85C \uB3CC\uC544\uC640 \uC54C\uC744
    \uB0B3\uC744 \uAC70\uC57C."
  rescuedLine: "\uC624\uB298 \uB124\uAC00 24m \uC5D0\uC11C \uAD6C\uD574 \uC900 \uADF8
    \uAC70\uBD81\uCC98\uB7FC \uB9D0\uC774\uC57C."
