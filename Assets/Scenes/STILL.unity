  - {fileID: 1147486204}
  - {fileID: 1780268440}
  moveLine: "\uC5C4\uC9C0 \uB9C9\uB300\uB97C \uC55E\uC73C\uB85C \uBC00\uC5C8\uB2E4
    \uB193\uC73C\uBA74, \uAC00\uB9AC\uD0A8 \uACF3\uC73C\uB85C \uC774\uB3D9\uD574\uC694."
  pickUpLine: "\uBA3C\uC800 \uC7A5\uBE44\uB300\uC5D0\uC11C \uAD00\uCC30\uAE30\uB97C
    \uC9D1\uC5B4 \uBCF4\uC138\uC694."
  practiceLine: "\uC5F0\uC2B5 \uC218\uC870\uC758 \uBB3C\uACE0\uAE30\uC5D0 \uAD00\uCC30\uAE30\uB97C
    \uACA8\uB204\uACE0, \uB9C1\uC774 \uB2E4 \uCC30 \uB54C\uAE4C\uC9C0 \uC9C0\uCF1C\uBCF4\uC138\uC694."
  doneLine: "\uCCAB \uAE30\uB85D \uC131\uACF5! \uAC1C\uCC30\uAD6C\uAC00 \uC5F4\uB838\uC5B4\uC694.
    \uC5D8\uB9AC\uBCA0\uC774\uD130 \uC548\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
  boardRadius: 0.7
