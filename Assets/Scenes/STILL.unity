--- !u!114 &855948802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 855948801}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c17cdbe26391b5f4ebc64a168fd08c46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BathysphereStory
  title: "\uBE44\uBE0C\uC758 \uBC14\uC2DC\uC2A4\uD53C\uC5B4"
  spot: {fileID: 965138527}
  scene: {fileID: 30819006}
  sphere: {fileID: 1496995617}
  water: {fileID: 426034232}
  snow: {fileID: 1503562934}
  depthText: {fileID: 1135508313}
  needle: {fileID: 1098788191}
  maxDepth: 923
  hatchetfish: {fileID: 1355930083}
  viperfish: {fileID: 1379593681}
  constellation: {fileID: 2019601110}
  vampireSquid: {fileID: 133537954}
  angler: {fileID: 212334570}
  searchlight: {fileID: 386867174}
  lightRange: 4.5
  lightAngle: 64
  lightIntensity: 2.4
  lightColor: {r: 1, g: 0.9, b: 0.75, a: 1}
  phonePanel: {fileID: 1015871966}
  question: {fileID: 2071473370}
  choiceLabels:
  - {fileID: 2119666331}
  - {fileID: 1276600219}
  phone: {fileID: 1019812471}
  ring: {fileID: 8300000, guid: 45b0393f1dbd2824f9f27c750bfc8c62, type: 3}
  surfaceSpeaker: "\uC218\uBA74 \xB7 \uAE00\uB85C\uB9AC\uC544"
  surfaceVoice: Kore
  introLine: "1934\uB144 8\uC6D4, \uBC84\uBBA4\uB2E4 \uC55E\uBC14\uB2E4. \uC70C\uB9AC\uC5C4
    \uBE44\uBE0C\uC640 \uC624\uD2F0\uC2A4 \uBC14\uD134\uC740 \uC9C0\uB984 1.45m \uC1E0\uACF5
    '\uBC14\uC2DC\uC2A4\uD53C\uC5B4'\uC5D0 \uB4E4\uC5B4\uAC00, \uC904 \uD558\uB098\uC5D0
    \uB9E4\uB2EC\uB824 \uB0B4\uB824\uAC14\uC5B4\uC694. \uCC3D\uC740 \uC190\uBC14\uB2E5\uB9CC
    \uD55C \uC11D\uC601 \uCC3D \uD558\uB098, \uADF8 \uBC14\uAE65\uC5D0 \uD0D0\uC870\uB4F1
    \uD558\uB098\uBFD0\uC774\uC5D0\uC694."
  callLine: "\uBC14\uC2DC\uC2A4\uD53C\uC5B4, \uB4E4\uB824\uC694? \uC5EC\uAE30\uB294
    \uC218\uBA74\uC774\uC5D0\uC694. \uC9C0\uAE08\uBD80\uD130 \uB0B4\uB9BD\uB2C8\uB2E4.
    \uCC3D\uBC16\uC5D0 \uBCF4\uC774\uB294 \uAC78 \uC804\uD654\uB85C \uC54C\uB824
    \uC8FC\uC138\uC694."
  blueLine: "\uBB3C\uBE5B\uC774 \uC810\uC810 \uC9D9\uC740 \uD30C\uB791\uC73C\uB85C
    \uBC14\uB00C\uC5B4\uC694. \uBE68\uAC04\uBE5B\uBD80\uD130 \uBA3C\uC800 \uC0AC\uB77C\uC838\uC694."
  ask300: "\uC9C0\uAE08 300m\uC608\uC694. \uCC3D\uBC16\uC5D0 \uBB34\uC5C7\uC774 \uBCF4\uC774\uB098\uC694?"
  choices300:
  - "\uC791\uC740 \uBE5B\uB4E4\uC774 \uBC18\uC9DD\uC5EC\uC694"
  - "\uC544\uBB34\uAC83\uB3C4 \uC548 \uBCF4\uC5EC\uC694"
  reply300Seen: "\uC2A4\uC2A4\uB85C \uBE5B\uC744 \uB0B4\uB294 \uBB3C\uACE0\uAE30\uC608\uC694!
    \uC740\uBE5B \uC190\uB3C4\uB07C\uACE0\uAE30 \u2014 \uBC30 \uCABD \uBC1C\uAD11\uAE30\uB85C
    \uC704\uC5D0\uC11C \uB0B4\uB824\uC624\uB294 \uD76C\uBBF8\uD55C \uBE5B\uC5D0 \uADF8\uB9BC\uC790\uB97C
    \uC9C0\uC6CC\uC11C, \uC544\uB798\uC5D0\uC11C \uC62C\uB824\uB2E4\uBCF4\uB294 \uC0AC\uB0E5\uAFBC
    \uB208\uC5D0 \uC798 \uB744\uC9C0 \uC54A\uC544\uC694."
  reply300None: "\uC870\uAE08\uB9CC \uB354 \uC9C0\uCF1C\uBCF4\uC138\uC694. \uAE5C\uAE5C\uD574\uC9C8\uC218\uB85D
    \uBE5B\uC774 \uB354 \uC798 \uBCF4\uC5EC\uC694."
  viperLine: "\uB3C5\uC0AC\uACE0\uAE30\uC608\uC694. \uC785\uC5D0 \uB2E4 \uB4E4\uC5B4\uAC00\uC9C0\uB3C4
    \uC54A\uC744 \uB9CC\uD07C \uAE34 \uC774\uBE68\uB85C, \uC5B4\uB460 \uC18D\uC5D0\uC11C
    \uBA39\uC774\uB97C \uBD99\uC7A1\uC544\uC694."
  ask580: "\uC9C0\uAE08 580m\uC608\uC694. \uCC3D\uBC16\uC5D0 \uBB34\uC5C7\uC774 \uBCF4\uC774\uB098\uC694?"
  choices580:
  - "\uBE5B\uC904 \uB2E4\uC12F \uAC1C\uAC00 \uC788\uB294 \uBB3C\uACE0\uAE30!"
  - "\uD478\uB978\uBE5B \uC0DD\uBB3C!"
  reply580: "\uBC1B\uC544 \uC801\uC5C8\uC5B4\uC694! 1934\uB144 8\uC6D4 11\uC77C,
    \uBE44\uBE0C\uB3C4 \uBC14\uB85C \uC774 \uAE4A\uC774\uC5D0\uC11C \uB178\uB780
    \uBE5B\uC810\uC774 \uB2E4\uC12F \uC904\uB85C \uB298\uC5B4\uC120 \uBB3C\uACE0\uAE30\uB97C
    \uBCF4\uACE0 '\uB2E4\uC12F \uC904 \uBCC4\uC790\uB9AC \uBB3C\uACE0\uAE30'\uB77C\uACE0
    \uC774\uB984 \uBD99\uC600\uC5B4\uC694. \uADF8 \uB4A4\uB85C \uC544\uBB34\uB3C4
    \uB2E4\uC2DC \uBCF4\uC9C0 \uBABB\uD588\uC5B4\uC694."
  combJellyLine: "\uC5B4\uB5A4 \uACFC\uD559\uC790\uB4E4\uC740 \uBE44\uBE0C\uAC00
    \uBCF8 \uAC8C \uBB3C\uACE0\uAE30\uAC00 \uC544\uB2C8\uB77C \uBE57\uD574\uD30C\uB9AC\uC600\uC744
    \uAC70\uB77C\uACE0 \uD574\uC694. \uC624\uB298 \uBC24 1,000m \uC5D0\uC11C \uB9CC\uB09C
    {name}\uCC98\uB7FC, \uBAB8\uC744 \uB530\uB77C \uBE5B\uC904\uC774 \uD750\uB974\uB294
    \uC0DD\uBB3C\uC774\uC694."
  darkLine: "\uC774\uC81C \uD587\uBE5B\uC774 \uAC70\uC758 \uB2FF\uC9C0 \uC54A\uC544\uC694.
    \uBE44\uBE0C\uB294 \uC774 \uC5B4\uB460\uC744, \uC9C0\uAE08\uAE4C\uC9C0 \uBCF8
    \uC5B4\uB5A4 \uAC80\uC815\uBCF4\uB2E4 \uB354 \uAC80\uB2E4\uACE0 \uC801\uC5C8\uC5B4\uC694."
  vampireLine: "\uD761\uD608\uC624\uC9D5\uC5B4\uC608\uC694. \uC774\uB984\uACFC \uB2EC\uB9AC
    \uD53C\uB294 \uBA39\uC9C0 \uC54A\uACE0, \uB5A0\uB2E4\uB2C8\uB294 \uBC14\uB2E4\uB208\uC744
    \uBAA8\uC544 \uBA39\uC5B4\uC694. \uC0B0\uC18C\uAC00 \uC544\uC8FC \uC801\uC740
    \uC774 \uAE4A\uC774\uC5D0\uC11C \uC0B4\uC544\uC694."
  arriveLine: "8\uC6D4 15\uC77C, 923m \u2014 \uADF8\uB54C\uAE4C\uC9C0 \uC0AC\uB78C\uC774
    \uB0B4\uB824\uAC04 \uAC00\uC7A5 \uAE4A\uC740 \uACF3\uC774\uC5D0\uC694! \uCC3D\uBC16\uC744
    \uC798 \uBCF4\uC138\uC694."
  anglerLine: "\uBA38\uB9AC\uC5D0 \uB4F1\uBD88\uC744 \uB2E8 \uC544\uADC0\uC608\uC694.
    \uC774 \uC5B4\uB460\uC5D0\uC11C\uB294 \uBE5B\uC774 \uBA39\uC774\uB97C \uBD80\uB974\uB294
    \uBBF8\uB07C\uAC00 \uB3FC\uC694."
  outroLine: "90\uB144 \uC804 \uBE44\uBE0C\uAC00 \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC,
    \uC624\uB298 \uB2F9\uC2E0\uB3C4 \uC544\uBB34\uB3C4 \uBCF8 \uC801 \uC5C6\uB294
    \uC0DD\uBB3C\uC744 \uAE30\uB85D\uD588\uC5B4\uC694. \uBC14\uB2E4\uB294 \uC544\uC9C1
    \uADF8\uB7F0 \uC774\uC57C\uAE30\uB85C \uAC00\uB4DD\uD574\uC694."
  waitChoice: 25
