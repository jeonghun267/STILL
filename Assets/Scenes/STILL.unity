  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1158766049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61ece77050c58ca4c910446011b88ac7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  npc: {fileID: 777469861}
  lobby: {fileID: 1857781243}
  whale: {fileID: 511024155}
  tutorial: {fileID: 0}
  speaker: "\uBCF4\uB9AC \uC120\uC7A5"
  voice: Charon
  nodes:
  - id: start
    line: "\uC5B4\uC774, \uC80A\uC740 \uD0D0\uD5D8\uAC00! \uB098\uB294 \uBCF4\uB9AC
      \uC120\uC7A5\uC77C\uC138. \uC0AC\uC2ED \uB144 \uB3D9\uC548 \uBC30\uB97C \uBAB0\uB2E4\uAC00,
      \uC9C0\uAE08\uC740 \uC774 \uD14C\uB77C\uC2A4\uC5D0\uC11C \uBC14\uB2E4\uB97C
      \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uC9C0. \uC774 \uB140\uC11D\uC740 \uB0B4 \uC575\uBB34\uC0C8
      \uC5B4\uB2C8\uC2A4\uD2B8\uACE0."
    set: met
    choices:
    - label: "\uC624\uB298 1,000m\uAE4C\uC9C0 \uB0B4\uB824\uAC00\uC694"
      next: dive
    - label: "\uC5B4\uB2C8\uC2A4\uD2B8, \uC548\uB155!"
      next: parrot
  - id: parrot
    line: "\uC5B4\uB2C8\uC2A4\uD2B8\uAC00 '\uC548\uB155, \uC548\uB155!' \uD558\uB294\uAD6C\uBA3C.
      \uBC14\uB2F7\uBC14\uB78C\uB9CC \uBD88\uBA74 \uC800\uB807\uAC8C \uC2E0\uC774
      \uB09C\uB2E4\uB124. \uADF8\uB798, \uC790\uB124\uB294 \uC624\uB298 \uC5B4\uB514\uAE4C\uC9C0
      \uB0B4\uB824\uAC00\uB098?"
    set: 
    choices:
    - label: "1,000m\uAE4C\uC9C0\uC694"
      next: dive
  - id: dive
    line: "1,000m\uB77C\uACE0? \uD5C8\uD5C8, \uB098\uB294 \uD3C9\uC0DD \uBC14\uB2E4
      \uC704\uC5D0\uB9CC \uC788\uC5C8\uC9C0, \uADF8 \uC544\uB798\uB294 \uD55C \uBC88\uB3C4
      \uBABB \uBD24\uB2E4\uB124. \uADF8\uB7F0\uB370 \uC694\uC998 \uAD00\uCE21\uC18C\uAC00
      \uC220\uB801\uC774\uB354\uAD70. \uC800 \uC544\uB798\uC11C 3\uC8FC\uC9F8 \uC774\uC0C1\uD55C
      \uC2E0\uD638\uAC00 \uC7A1\uD78C\uB2E4\uC9C0?"
    set: 
    choices:
    - label: "\uADF8 \uC2E0\uD638, \uBB54\uC9C0 \uC544\uC138\uC694?"
      next: story
    - label: "\uACE0\uB798\uB3C4 \uBCF4\uC168\uC5B4\uC694?"
      next: whale_quest
  - id: story
    line: "\uB531 \uD55C \uBC88 \uBE44\uC2B7\uD55C \uAC78 \uBCF8 \uC801\uC774 \uC788\uC9C0.
      \uC0BC\uC2ED \uB144 \uC804 \uD3ED\uD48D\uC6B0 \uCE58\uB358 \uBC24, \uC5D4\uC9C4\uC774
      \uBA48\uCDB0\uC11C \uBD88\uC744 \uB2E4 \uB044\uACE0 \uC228\uC8FD\uC778 \uCC44
      \uB5A0 \uC788\uC5C8\uB2E4\uB124. \uADF8\uB7F0\uB370 \uBC30 \uBC11\uC5D0\uC11C
      \uD478\uB978\uBE5B\uC774 \uCC9C\uCC9C\uD788 \uC62C\uB77C\uC624\uB354\uAD70."
    set: 
    choices:
    - label: "\uADF8\uB798\uC11C\uC694?"
      next: story2
  - id: story2
    line: "\uC190\uC804\uB4F1\uC744 \uBE44\uCD94\uB294 \uC21C\uAC04, \uC2A4\uB974\uB974
      \uC0AC\uB77C\uC838 \uBC84\uB838\uC5B4. \uADF8 \uB4A4\uB85C \uB298 \uC0DD\uAC01\uD588\uC9C0.
      \uC5B4\uB5A4 \uB140\uC11D\uB4E4\uC740 \uBE5B\uC744 \uC2EB\uC5B4\uD574\uC11C,
      \uBD88\uC744 \uB044\uACE0 \uAC00\uB9CC\uD788 \uAE30\uB2E4\uB824\uC57C \uB9CC\uB0A0
      \uC218 \uC788\uB294 \uAC8C \uC544\uB2D0\uAE4C \uD558\uACE0."
    set: signalTold
    choices:
    - label: "\uAE30\uC5B5\uD574 \uB458\uAC8C\uC694"
      next: farewell
    - label: "\uACE0\uB798 \uC598\uAE30\uB3C4 \uD574 \uC8FC\uC138\uC694"
      next: whale_quest
  - id: farewell
    line: "\uADF8\uB798, \uC870\uC2EC\uD788 \uB2E4\uB140\uC624\uAC8C. \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294
      \uC800 \uC548\uCABD\uC774\uB77C\uB124. \uC5B4\uB2C8\uC2A4\uD2B8\uB3C4 \uC751\uC6D0\uD558\uACE0
      \uC788\uB2E4\uB124!"
    set: 
    choices:
    - label: "\uB2E4\uB140\uC62C\uAC8C\uC694!"
      next: 
  - id: whale_quest
    line: "\uC800\uAE30 \uC30D\uC548\uACBD \uBCF4\uC774\uC9C0? \uC5BC\uAD74\uC744
      \uB300\uACE0 \uB9CC \uD55C\uAC00\uC6B4\uB370\uB97C \uC0B4\uD3B4\uBCF4\uAC8C.
      \uD639\uB4F1\uACE0\uB798\uAC00 \uC228 \uC26C\uB7EC \uC62C\uB77C\uC624\uBA74
      \uD558\uC580 \uBB3C\uAE30\uB465\uC774 \uC19F\uB294\uB2E4\uB124. \uCC3E\uC73C\uBA74
      \uAF2D \uC54C\uB824 \uC8FC\uAC8C!"
    set: whaleAsked
    choices:
    - label: "\uCC3E\uC544\uBCFC\uAC8C\uC694!"
      next: 
    - label: "\uC2E0\uD638 \uC598\uAE30\uB3C4 \uD574 \uC8FC\uC138\uC694"
      next: story
  - id: whale_wait
    line: "\uACE0\uB798\uB294 \uCC3E\uC558\uB098? \uBB3C\uAE30\uB465\uBD80\uD130
      \uCC3E\uC544\uBCF4\uAC8C. \uC228 \uC26C\uB7EC \uC790\uC8FC \uC62C\uB77C\uC628\uB2E4\uB124.
      \uBC14\uB78C\uC774 \uC794\uC794\uD558\uBA74 '\uD478\uC6B0' \uD558\uB294 \uC228\uC18C\uB9AC\uB3C4
      \uB4E4\uB9AC\uC9C0."
    set: 
    choices:
    - label: "\uB2E4\uC2DC \uBCFC\uAC8C\uC694"
      next: 
    - label: "\uC2E0\uD638 \uC598\uAE30 \uB2E4\uC2DC \uD574 \uC8FC\uC138\uC694"
      next: story
  - id: whale_found
    line: "\uBD24\uAD6C\uBA3C! \uADF8 \uB140\uC11D\uC740 \uC774 \uB9CC\uC5D0 \uC790\uC8FC
      \uB4E4\uB974\uB294 \uD639\uB4F1\uACE0\uB798\uB77C\uB124. \uAF2C\uB9AC \uC544\uB7AB\uBA74
      \uBB34\uB2AC\uB294 \uACE0\uB798\uB9C8\uB2E4 \uB2E4 \uB2EC\uB77C\uC11C, \uADF8
      \uBB34\uB2AC\uB85C \uB204\uAC00 \uB204\uAD70\uC9C0 \uC54C\uC544\uBCF8\uB2E4\uB124."
    set: whaleThanked
    choices:
    - label: "\uC0AC\uB78C \uC9C0\uBB38 \uAC19\uB124\uC694!"
      next: whale_found2
  - id: whale_found2
    line: "\uD5C8\uD5C8, \uBC14\uB85C \uADF8\uAC70\uC57C! \uC790\uB124\uB294 \uAD00\uCC30\uD558\uB294
      \uB208\uC774 \uC88B\uAD6C\uBA3C. \uADF8 \uB208\uC774\uBA74 \uC800 \uAE4A\uC740
      \uBC14\uB2E4\uC5D0\uC11C\uB3C4 \uC798 \uD574\uB0BC \uAC78\uC138."
    set: 
    choices:
    - label: "\uB2E4\uB140\uC62C\uAC8C\uC694!"
      next: 
    - label: "\uC2E0\uD638 \uC598\uAE30 \uB2E4\uC2DC \uD574 \uC8FC\uC138\uC694"
      next: story
  - id: revisit
    line: "\uB610 \uC654\uAD6C\uBA3C! \uBC14\uB2E4\uB294 \uB298 \uAC19\uC544 \uBCF4\uC5EC\uB3C4
      \uB9E4\uC77C \uB2EC\uB77C. \uC624\uB298\uC740 \uC800 \uC544\uB798\uC11C \uBB58
      \uBCF4\uAC8C \uB420\uC9C0 \uB098\uB3C4 \uAD81\uAE08\uD558\uB2E4\uB124."
    set: 
    choices:
    - label: "\uC2E0\uD638 \uC598\uAE30 \uB2E4\uC2DC \uD574 \uC8FC\uC138\uC694"
      next: story
    - label: "\uACE0\uB798\uB294 \uC5B4\uB514\uC11C \uBD10\uC694?"
      next: whale_quest
  - id: night
    line: "\uB3CC\uC544\uC654\uAD70! \uAD00\uCE21\uC18C\uC5D0 \uBD88\uC774 \uD658\uD558\uAC8C
      \uCF1C\uC9C4 \uAC78 \uBCF4\uACE0 \uC54C\uC558\uC9C0. \uADF8 \uD478\uB978\uBE5B\u2026
      \uC790\uB124\uAC00 \uC815\uB9D0 \uB9CC\uB0AC\uAD6C\uBA3C."
    set: 
    choices:
    - label: "\uBD88\uC744 \uB044\uACE0 \uAC00\uB9CC\uD788 \uC788\uC5C8\uB354\uB2C8
        \uB2E4\uAC00\uC654\uC5B4\uC694"
      next: night2
  - id: night2
    line: "\uADF8\uB807\uC9C0, \uADF8\uB807\uC9C0! \uB0B4\uAC00 \uC0BC\uC2ED \uB144
      \uB3D9\uC548 \uBABB \uBCF8 \uAC78 \uC790\uB124\uAC00 \uC624\uB298 \uAE30\uB85D\uD588\uC5B4.
      \uBC14\uB2E4\uC5D4 \uC544\uC9C1 \uC544\uBB34\uB3C4 \uBABB \uBCF8 \uAC8C \uD6E8\uC52C
      \uB9CE\uB2E4\uB124. \uB610 \uC624\uAC8C, \uD0D0\uD5D8\uAC00."
    set: 
    choices:
    - label: "\uB610 \uC62C\uAC8C\uC694!"
      next: 
