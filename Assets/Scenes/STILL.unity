  m_text: "<b>\uBC14\uC2DC\uC2A4\uD53C\uC5B4  BATHYSPHERE</b>\n<size=70%>1930\uB144,
    \uC70C\uB9AC\uC5C4 \uBE44\uBE0C\uC640 \uC624\uD2F0\uC2A4 \uBC14\uD134\uC740 \uC774
    \uC9C0\uB984 1.45m\uC758 \uC1E0\uACF5\uC744 \uD0C0\uACE0 \uC0AC\uB78C\uC73C\uB85C\uC11C
    \uCC98\uC74C \uAE4A\uC740 \uBC14\uB2E4\uB97C \uC9C1\uC811 \uB4E4\uC5EC\uB2E4\uBD24\uB2E4.
    1934\uB144\uC5D0\uB294 \uC218\uC2EC 923m\uAE4C\uC9C0 \uB0B4\uB824\uAC14\uB2E4.
    \uADF8\uB0A0 \uBE44\uBE0C\uB294 \uB2E4\uC12F \uC904\uB85C \uBE5B\uB098\uB294
    \uBB3C\uACE0\uAE30\uB97C \uBCF4\uACE0 \uADF8\uB9BC\uC73C\uB85C \uB0A8\uACBC\uC9C0\uB9CC,
    \uADF8 \uB4A4\uB85C \uC544\uBB34\uB3C4 \uB2E4\uC2DC \uBCF4\uC9C0 \uBABB\uD588\uB2E4.</size>"
