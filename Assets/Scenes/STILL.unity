MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 821670909}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2dfbe8766413277489955829eb6e8013, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NextSignalStory
  title: "\uB2E4\uC74C \uC2E0\uD638 2,500m"
  spot: {fileID: 690853390}
  scene: {fileID: 1131621812}
  cabin: {fileID: 1954045881}
  rovPivot: {fileID: 289791250}
  rovCamera: {fileID: 1374667872}
  yawLimit: 70
  yawStep: 20
  turnSpeed: 45
  aimDegrees: 9
  dwell: 1.5
  propellers:
  - {fileID: 1776758118}
  - {fileID: 966517296}
  - {fileID: 683198145}
  - {fileID: 1675701339}
  propIdle: 150
  rovLight: {fileID: 1142732874}
  lightRange: 13
  lightAngle: 70
  lightIntensity: 3.2
  lightColor: {r: 0.85, g: 0.93, b: 1, a: 1}
  monitorTop: {fileID: 1242670865}
  monitorStatus: {fileID: 1562639652}
  crosshair: {fileID: 1821724412}
  targets:
  - name: "\uAC80\uC740 \uAD74\uB69D"
    point: {fileID: 669183025}
    line: "\uAC80\uC740 \uAD74\uB69D \u2014 \uB545\uC18D\uC5D0\uC11C 350\uB3C4\uAC00
      \uB118\uB294 \uBB3C\uC774 \uAD11\uBB3C\uC744 \uB179\uC5EC \uBFDC\uC5B4\uB0B4\uC694.
      \uAC80\uC740 \uC5F0\uAE30\uCC98\uB7FC \uBCF4\uC774\uB294 \uAC74 \uC544\uC8FC
      \uC791\uC740 \uAD11\uBB3C \uC54C\uAC31\uC774\uC608\uC694."
  - name: "\uAD00\uBC8C\uB808"
    point: {fileID: 97310239}
    line: "\uAD00\uBC8C\uB808 \u2014 \uC785\uB3C4 \uC704\uB3C4 \uC5C6\uC5B4\uC694.
      \uBAB8\uC18D \uC138\uADE0\uC774 \uC5F4\uC218\uAD6C\uC758 \uD669\uD654\uC218\uC18C\uB85C
      \uC591\uBD84\uC744 \uB9CC\uB4E4\uC5B4 \uC918\uC694. \uD587\uBE5B \uC5C6\uC774
      \uC0AC\uB294 \uC0DD\uBB3C\uC774\uC5D0\uC694."
  - name: "\uC5F4\uC218\uAD6C \uAC8C"
    point: {fileID: 1555373645}
    line: "\uC5F4\uC218\uAD6C \uAC8C \u2014 \uBAB8\uC774 \uD558\uC597\uACE0, \uB2E4
      \uC790\uB77C\uBA74 \uB208\uC774 \uAC70\uC758 \uBCF4\uC774\uC9C0 \uC54A\uC544\uC694.
      \uAE5C\uAE5C\uD55C \uACF3\uC774\uB77C \uB208 \uB300\uC2E0 \uB0C4\uC0C8\uC640
      \uAC10\uAC01\uC73C\uB85C \uBA39\uC774\uB97C \uCC3E\uC544\uC694."
  ping: {fileID: 821670912}
  pingClip: {fileID: 8300000, guid: b7ada35e10007bf4790a3f6da286c94f, type: 3}
  recordClip: {fileID: 8300000, guid: bdd5f9de070f88342a914f9ada4d91f4, type: 3}
  introLine: "\uB370\uC774\uD130 \uC6D4 \uB9C8\uC9C0\uB9C9 \uC904\uC758 \uC0C8 \uC2E0\uD638
    \u2014 \uC218\uC2EC 2,500m. \uC7A0\uC218\uC815\uC774 \uD574\uC800 \uC5F4\uC218\uAD6C\uC5D0
    \uB0B4\uB824\uC654\uC5B4\uC694. \uD587\uBE5B\uC740 \uD55C \uC904\uAE30\uB3C4
    \uB2FF\uC9C0 \uC54A\uC9C0\uB9CC, \uB545\uC18D\uC5D0\uC11C \uB728\uAC70\uC6B4
    \uBB3C\uC774 \uBFDC\uC5B4\uC838 \uB098\uC640\uC694."
  howLine: "\uC624\uB978\uCABD \uD654\uBA74\uC740 \uBC16\uC5D0 \uC788\uB294 \uB85C\uBD07
    \uCE74\uBA54\uB77C\uC608\uC694. \uC544\uB798 \uB2E8\uCD94\uB85C \uCE74\uBA54\uB77C\uB97C
    \uB3CC\uB824 \uD654\uBA74 \uAC00\uC6B4\uB370 \uC2ED\uC790\uC5D0 \uB9DE\uCD94\uACE0,
    \uC7A0\uC2DC \uC9C0\uCF1C\uBCF4\uBA74 \uAE30\uB85D\uB3FC\uC694. \uC138 \uAC00\uC9C0\uB97C
    \uCC3E\uC544\uBCF4\uC138\uC694."
  nudgeLine: "\uB2E8\uCD94\uB85C \uCE74\uBA54\uB77C\uB97C \uC67C\uCABD, \uC624\uB978\uCABD\uC73C\uB85C
    \uB3CC\uB824 \uBCF4\uC138\uC694. \uAD74\uB69D \uB458\uB808\uC5D0 \uBB34\uC5B8\uAC00
    \uC0B4\uACE0 \uC788\uC5B4\uC694."
  signalLine: "\u2026\uBC29\uAE08, \uB610 \uC2E0\uD638\uAC00 \uC7A1\uD614\uC5B4\uC694.
    \uC774\uBC88\uC5D4 \uD6E8\uC52C \uB354 \uAE4A\uC740 \uACF3\uC774\uC5D0\uC694.
    \uBC14\uB2E4\uB294 \uC544\uC9C1, \uC6B0\uB9AC\uAC00 \uBAA8\uB974\uB294 \uAC83\uC73C\uB85C
    \uAC00\uB4DD\uD574\uC694."
