  introLines:
  - "1930\uB144, \uB450 \uC0AC\uB78C\uC774 \uC791\uC740 \uC1E0\uACF5\uC744 \uD0C0\uACE0
    \uCC98\uC74C\uC73C\uB85C \uAE4A\uC740 \uBC14\uB2E4\uB97C \uB4E4\uC5EC\uB2E4\uBD24\uC2B5\uB2C8\uB2E4."
  - "\uC9C0\uAD6C \uD45C\uBA74\uC758 71%\uB294 \uBC14\uB2E4\uC785\uB2C8\uB2E4."
  - "\uD558\uC9C0\uB9CC \uADF8 \uBC14\uB2E4\uC758 80% \uC774\uC0C1\uC740, \uC544\uC9C1
    \uC544\uBB34\uB3C4 \uBCF8 \uC801\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB298, \uB2F9\uC2E0\uC774 \uADF8 \uB2E4\uC74C \uAD00\uCC30\uC790\uC785\uB2C8\uB2E4.
    \uAD00\uCE21\uC18C\uC5D0 \uAC00\uAE30 \uC804\uC5D0, \uBC14\uB2F7\uAC00\uBD80\uD130
    \uB458\uB7EC\uBD10\uC694."
  descentLine: "\uD587\uBE5B\uC740 \uC218\uC2EC 200m\uAE4C\uC9C0\uB9CC \uB2FF\uC2B5\uB2C8\uB2E4.
    \uADF8 \uC544\uB798\uB294, \uC6B0\uB9AC\uAC00 \uAC70\uC758 \uBAA8\uB974\uB294
    \uC138\uACC4\uC785\uB2C8\uB2E4."
  arrivalLine: "\uC5EC\uAE30\uAC00 \uC218\uC2EC 24m \uC0B0\uD638\uCD08\uC608\uC694.
    \uD5E4\uC5C4\uCE58\uB294 \uC0DD\uBB3C\uC5D0 \uAD00\uCC30\uAE30\uB97C \uACA8\uB204\uACE0
    \uC9C0\uCF1C\uBCF4\uC138\uC694."
