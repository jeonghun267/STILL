  mooredBoat: {fileID: 481635956}
  captain: {fileID: 1333819349}
  captainSpot: {fileID: 1201878314}
  engineLabel: {fileID: 1122507775}
  lampLabel: {fileID: 28292904}
  engine: {fileID: 919622986}
  lampBulb: {fileID: 130261040}
  lampHalo: {fileID: 1111196821}
  click: {fileID: 602617976}
  clickClip: {fileID: 8300000, guid: 5bf057977d0be8b49a7c9a435f639124, type: 3}
  stillness: {fileID: 1584625299}
  seaGlow:
  - {fileID: 1617541868}
  - {fileID: 843482528}
  - {fileID: 1475500524}
  - {fileID: 224785063}
  - {fileID: 47842555}
  - {fileID: 246247312}
  - {fileID: 1886734105}
  - {fileID: 960941764}
  - {fileID: 951490996}
  - {fileID: 1340483608}
  - {fileID: 1008647326}
  - {fileID: 2042563034}
  - {fileID: 513615690}
  - {fileID: 772517912}
  - {fileID: 1313957560}
  - {fileID: 1648406702}
  - {fileID: 683871402}
  - {fileID: 1423351186}
  - {fileID: 256147236}
  - {fileID: 1020186855}
  - {fileID: 67101395}
  - {fileID: 219863679}
  - {fileID: 754182496}
  - {fileID: 2007565562}
  - {fileID: 1194928720}
  - {fileID: 1929012820}
  - {fileID: 2144639664}
  - {fileID: 651353694}
  - {fileID: 496311402}
  - {fileID: 581300425}
  - {fileID: 1239549878}
  - {fileID: 307569974}
  - {fileID: 79132437}
  - {fileID: 192682510}
  - {fileID: 66095860}
  - {fileID: 1026310639}
  - {fileID: 576969086}
  - {fileID: 2060965905}
  - {fileID: 169254553}
  - {fileID: 1022649482}
  glowColor: {r: 0.22, g: 0.7, b: 1, a: 1}
  whale: {fileID: 691191249}
  whaleSpout: {fileID: 138025696}
  whaleBlow: {fileID: 691191250}
  whaleStart: {fileID: 1887438397}
  whaleEnd: {fileID: 1520277799}
  owner: {fileID: 948726807}
  ownerDepth: 4
  openLine: "\uC774\uC81C \uB0B4 \uCC28\uB840\uC77C\uC138. \uC0BC\uC2ED \uB144 \uC804,
    \uD3ED\uD48D\uC6B0\uAC00 \uC9C0\uB098\uAC04 \uBC24\u2026 \uBC14\uB85C \uC774
    \uBC14\uB2E4\uC5D0\uC11C \uADF8 \uD478\uB978\uBE5B\uC744 \uBD24\uC9C0."
  switchLine: "\uC5D4\uC9C4\uC744 \uB044\uACE0, \uAC11\uD310 \uBD88\uB3C4 \uAEBC
    \uC8FC\uAC8C. \uC55E\uCABD \uB09C\uAC04\uC758 \uB2E8\uCD94 \uB450 \uAC1C\uB77C\uB124."
  stillLine: "\uC88B\uC544\u2026 \uC774\uC81C \uAC00\uB9CC\uD788 \uC788\uC5B4 \uBCF4\uAC8C.
    \uADF8\uB0A0 \uBC24\uB3C4 \uC5D4\uC9C4\uC774 \uBA4E\uC5B4 \uC774\uB807\uAC8C
    \uC870\uC6A9\uD588\uC9C0. \uAE4A\uC740 \uBC14\uB2E4 \uB140\uC11D\uB4E4\uC740
    \uBD88\uBE5B\uACFC \uC5D4\uC9C4 \uC18C\uB9AC\uB97C \uD53C\uD558\uAC70\uB4E0."
  glowLine: "\uBCF4\uAC8C, \uBB3C\uC774 \uBE5B\uB098\uAE30 \uC2DC\uC791\uD558\uB294\uAD6C\uBA3C.
    \uC57C\uAD11 \uD50C\uB791\uD06C\uD1A4\uC774\uB77C\uB124. \uBC30\uAC00 \uBA48\uCD94\uB2C8
    \uBC14\uB2E4\uAC00 \uAE68\uC5B4\uB098\uB294 \uAC8C\uC57C."
  whaleLine: "\uC800\uAE30! \uD5A5\uC720\uACE0\uB798\uAC00 \uC228\uC744 \uC26C\uB7EC
    \uC62C\uB77C\uC654\uC5B4. \uAE4A\uC740 \uBC14\uB2E4\uC5D0\uC11C \uC0AC\uB0E5\uD558\uACE0
    \uB3CC\uC544\uC628 \uAC78\uC138."
  whyLine: "\uADF8\uAC70 \uC544\uB098? \uBC24\uC774 \uB418\uBA74 \uAE4A\uC740 \uBC14\uB2E4\uC758
    \uB9CE\uC740 \uC0DD\uBB3C\uC774 \uBA39\uC774\uB97C \uB530\uB77C \uC218\uBA74
    \uAC00\uAE4C\uC774 \uC62C\uB77C\uC628\uB2E4\uB124. \uD574\uAC00 \uB728\uAE30
    \uC804\uC5D0 \uB2E4\uC2DC \uB0B4\uB824\uAC00\uACE0. \uC790\uB124\uAC00 200m \uC5D0\uC11C
    \uBCF8, \uC704\uB85C \uC19F\uB358 \uBE5B \uC54C\uAC31\uC774 \uAE30\uB465 \u2014
    \uADF8\uAC8C \uBC14\uB85C \uADF8 '\uBC24\uC758 \uB300\uC774\uB3D9'\uC77C\uC138.
    \uADF8\uB0A0 \uBC24 \uB0B4\uAC00 \uBCF8 \uD478\uB978\uBE5B\uB3C4 \uADF8\uB807\uAC8C
    \uC62C\uB77C\uC654\uB358 \uAC8C\uC57C."
  ownerLine: "\u2026\uC800\uAE30, \uBC30 \uC606\uC774\uC57C. \uC800 \uBE5B\u2026
    \uC0BC\uC2ED \uB144 \uB9CC\uC774\uAD70."
  thanksLine: "\uC138 \uBC88 \uAE5C\uBE61\uC600\uC5B4. \uC790\uB124\uAC00 1,000m
    \uC5D0\uC11C \uB9CC\uB09C \uBC14\uB85C \uADF8 \uC0DD\uBB3C\uC774\uC9C0? {name}
    \u2014 \uACE0\uB9D9\uB124, \uD0D0\uD5D8\uAC00. \uC790\uB124 \uB355\uBD84\uC5D0
    \uB2E4\uC2DC \uB9CC\uB0AC\uC5B4."
  switchWaitLimit: 45
  stillWaitLimit: 20
