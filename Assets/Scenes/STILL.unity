  m_Script: {fileID: 11500000, guid: fe065c99e8b112d4cbe69864d17b57a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaptainNightStory
  title: "\uC120\uC7A5\uC758 \uBC24\uBC14\uB2E4"
  spot: {fileID: 617318685}
