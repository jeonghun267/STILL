--- !u!114 &1078828334
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078828332}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61ece77050c58ca4c910446011b88ac7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  npc: {fileID: 1425649228}
  lobby: {fileID: 1857781243}
  whale: {fileID: 0}
  tutorial: {fileID: 1857781242}
  speaker: "\uB180\uB780"
  voice: Puck
  nodes:
  - id: start
    line: "\uC548\uB155! \uB098\uB294 \uB180\uB780\uC774\uC57C. \uC800 \uAD00\uCE21\uC18C\uC5D0
      \uAC00\uB294 \uAE38\uC774\uC9C0? \uADF8 \uC804\uC5D0 \uC774 \uC870\uC218 \uC6C5\uB369\uC774
      \uC880 \uBD10. \uBC14\uB2F7\uBB3C\uC774 \uBE60\uC9C0\uBA74 \uBC14\uC704 \uC0AC\uC774\uC5D0
      \uC774\uB807\uAC8C \uC791\uC740 \uBC14\uB2E4\uAC00 \uB0A8\uC544."
    set: met
    choices:
    - label: "\uC870\uC218 \uC6C5\uB369\uC774\uAC00 \uBB50\uC57C?"
      next: pool
    - label: "\uAD00\uCC30\uAE30\uB294 \uC5B4\uB5BB\uAC8C \uC368?"
      next: device
  - id: pool
    line: "\uBC00\uBB3C \uB54C \uB4E4\uC5B4\uC628 \uBC14\uB2F7\uBB3C\uC774 \uC370\uBB3C
      \uB54C \uBC14\uC704 \uC0AC\uC774\uC5D0 \uACE0\uC778 \uAC70\uC57C. \uAC8C, \uBD88\uAC00\uC0AC\uB9AC,
      \uC131\uAC8C \uAC19\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uC5EC\uAE30\uC11C \uB2E4\uC74C
      \uBC00\uBB3C\uC744 \uAE30\uB2E4\uB9AC\uC9C0."
    set: 
    choices:
    - label: "\uAD00\uCC30\uAE30\uB85C \uBCF4\uACE0 \uC2F6\uC5B4"
      next: device
  - id: device
    line: "\uC606 \uC7A5\uBE44\uB300 \uC704\uC5D0 \uAD00\uCC30\uAE30\uAC00 \uC788\uC5B4.
      \uC9D1\uC5B4\uC11C \uC6C5\uB369\uC774 \uC18D \uC0DD\uBB3C\uC5D0 \uACA8\uB204\uACE0,
      \uB9C1\uC774 \uB2E4 \uCC30 \uB54C\uAE4C\uC9C0 \uAC00\uB9CC\uD788 \uC9C0\uCF1C\uBCF4\uBA74
      \uAE30\uB85D\uB3FC. \uAC8C\uAC00 \uB290\uB824\uC11C \uC5F0\uC2B5\uD558\uAE30
      \uB531 \uC88B\uC544."
    set: 
    choices:
    - label: "\uD574 \uBCFC\uAC8C!"
      next: 
  - id: revisit_pre
    line: "\uAD00\uCC30\uAE30\uB294 \uC9D1\uC5C8\uC5B4? \uC6C5\uB369\uC774 \uC18D
      \uAC8C\uD55C\uD14C \uACA8\uB220 \uBD10. \uCC9C\uCC9C\uD788 \uAE30\uC5B4 \uB2E4\uB140\uC11C
      \uB530\uB77C\uAC00\uAE30 \uC26C\uC6CC."
    set: 
    choices:
    - label: "\uD574 \uBCFC\uAC8C!"
      next: 
    - label: "\uC870\uC218 \uC6C5\uB369\uC774\uAC00 \uBB50\uC57C?"
      next: pool
  - id: practiced_new
    line: "\uC640, \uBC8C\uC368 \uCCAB \uAE30\uB85D\uC744 \uD588\uAD6C\uB098! \uB098\uB294
      \uB180\uB780\uC774\uC57C. \uC6B0\uB9AC \uD560\uC544\uBC84\uC9C0\uAC00 \uC800
      \uB098\uBB34 \uACC4\uB2E8 \uC704 \uD14C\uB77C\uC2A4\uC5D0 \uACC4\uC154. \uBC14\uB2E4
      \uC774\uC57C\uAE30\uB97C \uC5C4\uCCAD \uB9CE\uC774 \uC544\uC2DC\uAC70\uB4E0."
    set: met,practicedSeen
    choices:
    - label: "\uD560\uC544\uBC84\uC9C0\uAC00 \uB204\uAD6C\uC57C?"
      next: grandpa
    - label: "\uAD00\uCE21\uC18C\uB294 \uC5B4\uB5BB\uAC8C \uAC00?"
      next: way
  - id: practiced
    line: "\uC640, \uCCAB \uAE30\uB85D\uC774\uB2E4! \uC774\uC81C \uC9C4\uC9DC \uAD00\uCC30\uC790\uB124.
      \uC6B0\uB9AC \uD560\uC544\uBC84\uC9C0\uAC00 \uC800 \uB098\uBB34 \uACC4\uB2E8
      \uC704 \uD14C\uB77C\uC2A4\uC5D0 \uACC4\uC154. \uBC14\uB2E4 \uC774\uC57C\uAE30\uB97C
      \uC5C4\uCCAD \uB9CE\uC774 \uC544\uC2DC\uAC70\uB4E0."
    set: practicedSeen
    choices:
    - label: "\uD560\uC544\uBC84\uC9C0\uAC00 \uB204\uAD6C\uC57C?"
      next: grandpa
    - label: "\uAD00\uCE21\uC18C\uB294 \uC5B4\uB5BB\uAC8C \uAC00?"
      next: way
  - id: grandpa
    line: "\uBCF4\uB9AC \uC120\uC7A5\uB2D8! \uC0AC\uC2ED \uB144 \uB3D9\uC548 \uBC30\uB97C
      \uBAA8\uC168\uC5B4. \uD478\uB978\uBE5B\uC744 \uBD24\uB2E4\uB294 \uC598\uAE30\uB294\u2026
      \uC9C1\uC811 \uB4E4\uC5B4 \uBD10. \uB098\uB294 \uBC31 \uBC88\uC740 \uB4E4\uC5C8\uC9C0\uB9CC
      \uADF8\uB798\uB3C4 \uBBFF\uC5B4."
    set: 
    choices:
    - label: "\uAC00 \uBCFC\uAC8C!"
      next: way
  - id: way
    line: "\uC800 \uB098\uBB34 \uACC4\uB2E8\uC73C\uB85C \uD14C\uB77C\uC2A4\uC5D0
      \uC62C\uB77C\uAC00\uC11C \uC720\uB9AC\uBB38\uC73C\uB85C \uB4E4\uC5B4\uAC00\uBA74
      \uAD00\uCE21\uC18C \uC548\uC774\uC57C. \uC5D8\uB9AC\uBCA0\uC774\uD130\uAC00
      \uC5F4\uB824 \uC788\uC744 \uAC70\uC57C. \uC798 \uB2E4\uB140\uC640!"
    set: 
    choices:
    - label: "\uB2E4\uB140\uC62C\uAC8C!"
      next: 
    - label: "\uB108\uB294 \uC5EC\uAE30\uC11C \uBB50 \uD574?"
      next: job
  - id: job
    line: "\uBC14\uB2F7\uAC00 \uC4F0\uB808\uAE30\uB97C \uC8FC\uC6CC. \uBC84\uB824\uC9C4
      \uADF8\uBB3C\uC774 \uC81C\uC77C \uBB34\uC11C\uC6CC. '\uC720\uB839 \uADF8\uBB3C'\uC774\uB77C\uACE0
      \uD558\uB294\uB370, \uBC14\uB2F7\uC18D\uC744 \uB5A0\uB2E4\uB2C8\uBA74\uC11C
      \uBB3C\uACE0\uAE30\uB791 \uBC14\uB2E4\uAC70\uBD81, \uACE0\uB798\uAE4C\uC9C0
      \uAC78\uB9AC\uAC8C \uD558\uAC70\uB4E0."
    set: netTold
    choices:
    - label: "\uB098\uB3C4 \uB3C4\uC6B8\uAC8C!"
      next: trash
  - id: trash
    line: "\uACE0\uB9C8\uC6CC! \uB0B4 \uC606 \uBAA8\uB798 \uC704\uC5D0 \uD398\uD2B8\uBCD1\uC774\uB791
      \uCE94, \uADF8\uBB3C \uC870\uAC01\uC774 \uB5A8\uC5B4\uC838 \uC788\uC5B4. \uC190\uC73C\uB85C
      \uD1A1 \uAC74\uB4DC\uB9AC\uAC70\uB098 \uCEE8\uD2B8\uB864\uB7EC\uB85C \uAC00\uB9AC\uD0A4\uACE0
      \uB204\uB974\uBA74 \uC218\uAC70\uD568\uC5D0 \uC3D9 \uB4E4\uC5B4\uAC00."
    set: 
    choices:
    - label: "\uC54C\uACA0\uC5B4!"
      next: 
  - id: revisit
    line: "\uB610 \uC654\uB124! \uD560\uC544\uBC84\uC9C0\uB294 \uB9CC\uB098 \uBD24\uC5B4?
      \uACC4\uB2E8 \uC704 \uD14C\uB77C\uC2A4\uC5D0 \uACC4\uC154. \uC30D\uC548\uACBD\uC73C\uB85C
      \uACE0\uB798\uB3C4 \uBCFC \uC218 \uC788\uC5B4."
    set: 
    choices:
    - label: "\uC720\uB839 \uADF8\uBB3C \uC598\uAE30 \uD574 \uC918"
      next: job
    - label: "\uD560\uC544\uBC84\uC9C0 \uC598\uAE30 \uD574 \uC918"
      next: grandpa
  - id: night_rescued
    line: "\uB3CC\uC544\uC654\uAD6C\uB098! \uBC29\uAE08 \uAD00\uCE21\uC18C\uC5D0\uC11C
      \uC5F0\uB77D\uC774 \uC654\uC5B4. \uB124\uAC00 24m\uC5D0\uC11C \uCC3E\uC740
      \uADF8\uBB3C\uC5D0 \uAC78\uB9B0 \uBC14\uB2E4\uAC70\uBD81 \uC788\uC796\uC544\u2026
      \uAD6C\uC870\uB300\uAC00 \uADF8\uBB3C\uC744 \uC798\uB77C \uC918\uC11C \uBB34\uC0AC\uD788
      \uD5E4\uC5C4\uCCD0 \uAC14\uB300!"
    set: rescueTold
    choices:
    - label: "\uB2E4\uD589\uC774\uB2E4!"
      next: night_waves
  - id: night
    line: "\uB3CC\uC544\uC654\uAD6C\uB098! \uC800\uAE30 \uBD10, \uD30C\uB3C4\uAC00
      \uD30C\uB797\uAC8C \uBE5B\uB098\uC9C0? \uC57C\uAD11 \uD50C\uB791\uD06C\uD1A4\uC774\uC57C.
      \uBB3C\uACB0\uC5D0 \uD754\uB4E4\uB9AC\uBA74 \uBE5B\uC744 \uB0B4. \uD560\uC544\uBC84\uC9C0\uAC00
      \uC544\uAE4C\uBD80\uD130 \uACC4\uC18D \uC2F1\uAE00\uBC99\uAE00\uC774\uC154.
      \uB124\uAC00 \uC800 \uC544\uB798\uC5D0\uC11C \uD478\uB978\uBE5B\uC744 \uB9CC\uB098\uC11C
      '{name}'{\uC774\uB77C\uACE0} \uC774\uB984\uC744 \uBD99\uC600\uB2E4\uACE0!"
    set: 
    choices:
    - label: "\uC9C4\uC9DC \uB9CC\uB0AC\uC5B4!"
      next: night2
  - id: night_waves
    line: "\uADF8\uB9AC\uACE0 \uC800\uAE30 \uBD10, \uD30C\uB3C4\uAC00 \uD30C\uB797\uAC8C
      \uBE5B\uB098\uC9C0? \uC57C\uAD11 \uD50C\uB791\uD06C\uD1A4\uC774\uC57C. \uBB3C\uACB0\uC5D0
      \uD754\uB4E4\uB9AC\uBA74 \uBE5B\uC744 \uB0B4. \uD560\uC544\uBC84\uC9C0\uAC00
      \uC544\uAE4C\uBD80\uD130 \uACC4\uC18D \uC2F1\uAE00\uBC99\uAE00\uC774\uC154.
      \uB124\uAC00 \uC800 \uC544\uB798\uC5D0\uC11C \uD478\uB978\uBE5B\uC744 \uB9CC\uB098\uC11C
      '{name}'{\uC774\uB77C\uACE0} \uC774\uB984\uC744 \uBD99\uC600\uB2E4\uACE0!"
    set: 
    choices:
    - label: "\uC9C4\uC9DC \uB9CC\uB0AC\uC5B4!"
      next: night2
  - id: night2
    line: "\uB300\uB2E8\uD558\uB2E4\u2026 \uB098\uB3C4 \uC5B8\uC820\uAC00 \uAF2D
      \uB0B4\uB824\uAC00 \uBCFC \uAC70\uC57C. \uADF8\uB54C\uAE4C\uC9C0 \uC5EC\uAE30
      \uBC14\uB2F7\uAC00\uB97C \uAE68\uB057\uD558\uAC8C \uC9C0\uD0A4\uACE0 \uC788\uC744\uAC8C!"
    set: 
    choices:
    - label: "\uB610 \uC62C\uAC8C!"
      next: 
