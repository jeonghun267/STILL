  bioSparks: {fileID: 1590875961}
  migration: {fileID: 990857757}
  bleachSpot: {fileID: 996536392}
  bleachLine: "{0} \uBCF4\uC138\uC694. \uC0B0\uD638\uAC00 \uD558\uC597\uAC8C \uBCC0\uD588\uC5B4\uC694.
    \uBC14\uB2F7\uBB3C\uC774 \uB108\uBB34 \uB530\uB73B\uD574\uC9C0\uBA74 \uC0B0\uD638
