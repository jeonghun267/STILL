  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HydrophoneCalls
  calls:
  - fish: {fileID: 11400000, guid: 829958c9624692f4b9509b71e6e9e9fa, type: 2}
    clip: {fileID: 8300000, guid: 7efde5a7266998d4b8d70ac32fab3a13, type: 3}
    notice: "\uC218\uC911 \uB9C8\uC774\uD06C \xB7 \uC544\uC8FC \uB0AE\uC740 \uB178\uB798
      (10\uBC30 \uBE60\uB974\uAC8C)"
    line: "\uB4E4\uB824\uC694? \uC218\uC911 \uB9C8\uC774\uD06C\uC5D0 \uC7A1\uD78C
      \uB178\uB798\uC608\uC694. \uB108\uBB34 \uB0AE\uC544\uC11C \uC6D0\uB798\uB294
      \uC0AC\uB78C \uADC0\uC5D0 \uB4E4\uB9AC\uC9C0 \uC54A\uC544, 10\uBC30 \uBE60\uB974\uAC8C
      \uBC14\uAFD4 \uB4E4\uB824\uC8FC\uACE0 \uC788\uC5B4\uC694. \uB204\uAD6C\uC758
      \uB178\uB798\uC77C\uAE4C\uC694?"
  - fish: {fileID: 11400000, guid: 3b4d43731cb0e3441af0f2b1eb966446, type: 2}
    clip: {fileID: 8300000, guid: 868073031577a394383a126359bb0c8d, type: 3}
    notice: "\uC218\uC911 \uB9C8\uC774\uD06C \xB7 \uB538\uAE4D\uB538\uAE4D \uC18C\uB9AC"
    line: "\uB538\uAE4D, \uB538\uAE4D\u2026 \uC218\uC911 \uB9C8\uC774\uD06C\uC5D0
      \uC7A1\uD78C \uC18C\uB9AC\uC608\uC694. \uAE5C\uAE5C\uD55C \uBC14\uB2E4\uC5D0\uC11C
