  m_Script: {fileID: 11500000, guid: 16242ff963f84814b886609912303dc8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreditsRoll
  group: {fileID: 921745247}
  content: {fileID: 66693175}
  viewport: {fileID: 487968698}
  text: {fileID: 66693173}
  view: {fileID: 1373153107}
  keepClear: {fileID: 2077120033}
  body: "<size=72><b>STILL</b></size>\n<size=30><color=#8FE6FF>\uD574\uC591 \uAD00\uCE21\uC18C
    STILL \xB7 1,000m \uC758 \uC2E0\uD638</color></size>\n\n\n<size=26><color=#8FB0C0>\uB9CC\uB4E0
    \uC0AC\uB78C</color></size>\nSTILL \uC81C\uC791\uD300\n\n<size=26><color=#8FB0C0>\uAD00\uCE21\uC18C\uC7A5\uC758
    \uBAA9\uC18C\uB9AC \xB7 \uC0DD\uBB3C \uC124\uBA85</color></size>\nGoogle Gemini\n(\uC77C\uC9C0\uC5D0
    \uC5C6\uB294 \uC0DD\uBB3C\uC740 \uACE0\uC815 \uB300\uBCF8)\n\n<size=26><color=#8FB0C0>\uBC14\uB2E4
    \uC0DD\uBB3C \xB7 \uC0B0\uD638 \uBAA8\uB378</color></size>\nLayer Lab \xB7 3D
    Characters - Fish (Unity Asset Store)\n\n<size=26><color=#8FB0C0>\uC2EC\uD574
    \uC0DD\uBB3C \xB7 \uACE0\uB798</color></size>\n\"Angler Fish - Inktober Day 3\"
    by lesliestowe\n\"Vampire Squid\" \xB7 \"Gigantura Chuni\" \xB7 \"Hatchet Fish\"
    by Razan Negm\n\"Dumbo Octopus\" by Erik\n\"Pacific Viperfish\" by redsonder1000\n\"Sperm
    Whale\" \xB7 \"Humpback Whale\" \xB7 \"Blue Rorqual\" by nolanfa\n<size=24>Sketchfab,
    CC BY 4.0 (modified: materials and scale)</size>\n\n<size=26><color=#8FB0C0>\uB85C\uBE44</color></size>\n\"Elevator
    - Low Poly Animated\" by JeffK, CC BY 4.0\n\"Animated Ticket Gate\" by \u20ACr!c,
    CC BY 4.0\n\"Bathysphere | New York Aquarium\" by sabster, CC BY 4.0\n<size=24>(modified:
    reduced polygons and texture size)</size>\nFurniture Kit \xB7 UI Pack \xB7 Kenney
    (CC0)\nSecluded Beach \xB7 Poly Haven (CC0)\n3D Free Modular Kit \xB7 Barking
    Dog (Unity Asset Store)\n\n<size=26><color=#8FB0C0>\uC18C\uB9AC</color></size>\n\"Exploration
    Theme\" \xB7 Cleyton Kauffman (CC0)\n\uBC14\uB2F7\uAC00 \uAC08\uB9E4\uAE30 \xB7
    selcukartut (Pixabay)\n\uBB3C\uC18D \uD558\uAC15 \xB7 DRAGON-STUDIO (Pixabay)\n\uBB3C\uC18C\uB9AC
    \xB7 \uBB3C\uBCF4\uB77C \xB7 \uC18C\uB098 \xB7 \uC885\uC18C\uB9AC \xB7 \uCF54\uB4DC\uB85C
    \uB9CC\uB4E0 \uC18C\uB9AC\n\n<size=26><color=#8FB0C0>\uAE00\uAF34 \xB7 \uC544\uC774\uCF58</color></size>\n\uB098\uB214\uC2A4\uD018\uC5B4\uB77C\uC6B4\uB4DC
    \xB7 NAVER (SIL OFL 1.1)\nMaterial Icons \xB7 Google (Apache 2.0)\n\n<size=26><color=#8FB0C0>\uBC14\uB2E4
    \uC22B\uC790</color></size>\n71% \xB7 80% \xB7 NOAA\n\n\n<size=40><b>\uC624\uB298
    \uBC24, \uAD00\uCE21\uD574 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694.</b></size>"
  distance: 1.9
  clearance: 3
  yawOffset: -40
  drop: 0.05
  speed: 42
  fadeSeconds: 1.2
