  m_Script: {fileID: 11500000, guid: 248d54a63e4410f47af2108788e88483, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LighthouseSignalStory
  title: "\uB4F1\uB300\uC758 \uC2E0\uD638"
  spot: {fileID: 1682004303}
  lighthouse: {fileID: 2113496240}
  signalBeam: {fileID: 1272410999}
  flashSeconds: 0.45
  leverRay: {fileID: 1902386059}
  leverPoke: {fileID: 1902386058}
  leverArm: {fileID: 1688413862}
  gap: 1.8
  idleLimit: 40
  seaLight: {fileID: 505758673}
  approach:
  - {fileID: 1877860847}
  - {fileID: 1568464555}
  - {fileID: 620740365}
  seaLightSize: 34
  creature: {fileID: 1127923492}
  shoreSpot: {fileID: 1487285696}
  chorus:
  - {fileID: 1105484055}
  - {fileID: 1996768365}
  - {fileID: 1202937408}
  - {fileID: 1296687787}
  - {fileID: 1388088654}
  - {fileID: 1169073447}
  - {fileID: 1377508716}
  - {fileID: 30656302}
  - {fileID: 1701731714}
  - {fileID: 547811473}
  - {fileID: 1129453868}
  - {fileID: 1201958825}
  - {fileID: 409713876}
  - {fileID: 1919041198}
  - {fileID: 164738170}
  - {fileID: 1393659965}
  - {fileID: 56436700}
  - {fileID: 1351969704}
  - {fileID: 167410702}
  - {fileID: 2030379830}
  - {fileID: 1698092454}
  - {fileID: 1626810420}
  - {fileID: 2142365642}
  - {fileID: 977591670}
  - {fileID: 1856863548}
  - {fileID: 366035212}
  blue: {r: 0.35, g: 0.8, b: 1.6, a: 1}
  leverSound: {fileID: 1902386055}
  leverClip: {fileID: 8300000, guid: 5bf057977d0be8b49a7c9a435f639124, type: 3}
  seaSound: {fileID: 501494663}
  seaClip: {fileID: 8300000, guid: b7ada35e10007bf4790a3f6da286c94f, type: 3}
  chorusClip: {fileID: 8300000, guid: bdd5f9de070f88342a914f9ada4d91f4, type: 3}
  introLine: "\uC5EC\uAE30\uB294 \uACF6 \uB05D \uB4F1\uB300 \uAF2D\uB300\uAE30\uC608\uC694.
    1987\uB144 \uAC00\uC744, \uC774 \uB4F1\uB300\uB97C \uC9C0\uD0A4\uB358 \uC0AC\uB78C\uC774
    \uC77C\uC9C0\uC5D0 \uC774\uC0C1\uD55C \uAC78 \uC801\uC5C8\uC5B4\uC694. '\uBC14\uB2E4
    \uCABD\uC5D0 \uD478\uB978 \uBE5B. \uB4F1\uC744 \uC138 \uBC88 \uAE5C\uBE61\uC600\uB354\uB2C8,
    \uBC14\uB2E4\uAC00 \uC138 \uBC88 \uB300\uB2F5\uD588\uB2E4.'"
  whyUpLine: "1,000m \uC5D0 \uC0AC\uB294 \uC0DD\uBB3C\uC774 \uC5B4\uB5BB\uAC8C \uBC14\uB2E4
    \uC704\uC5D0 \uC788\uC5C8\uC744\uAE4C\uC694? \uAE4A\uC740 \uBC14\uB2E4 \uC0DD\uBB3C
    \uC911\uC5D0\uB294 \uBC24\uC774 \uB418\uBA74 \uBA39\uC774\uB97C \uB530\uB77C
    \uC218\uBA74 \uAC00\uAE4C\uC774 \uC62C\uB77C\uC654\uB2E4\uAC00, \uD574\uAC00
    \uB728\uAE30 \uC804\uC5D0 \uB2E4\uC2DC \uB0B4\uB824\uAC00\uB294 \uB140\uC11D\uB4E4\uC774
    \uB9CE\uC544\uC694. 200m \uC5D0\uC11C \uBCF8, \uC704\uB85C \uC19F\uB358 \uBE5B
    \uC54C\uAC31\uC774 \uAE30\uB465 \u2014 \uADF8\uAC8C \uBC14\uB85C \uC774 '\uBC24\uC758
    \uB300\uC774\uB3D9'\uC774\uC5D0\uC694."
  lookLine: "\uC800\uAE30, \uBA3C \uBC14\uB2E4 \u2014 \uC138 \uBC88\uC529 \uAE5C\uBE61\uC774\uB294
    \uD478\uB978 \uBE5B \uBCF4\uC774\uC8E0? \uC624\uB298 \uBC24\uC5D0\uB3C4 \uC62C\uB77C\uC654\uC5B4\uC694."
  goalLine: "{name}\uC740 \uBE5B\uC73C\uB85C \uB9D0\uD574\uC694. \uAC19\uC740 \uC218\uB9CC\uD07C
    \uAE5C\uBE61\uC5EC \uB300\uB2F5\uD558\uBA74 '\uB098\uB3C4 \uC5EC\uAE30 \uC788\uC5B4'
    \uD558\uB294 \uC778\uC0AC\uAC00 \uB3FC\uC694. \uC778\uC0AC\uB97C \uC8FC\uACE0\uBC1B\uC744
    \uB54C\uB9C8\uB2E4 \uC870\uAE08\uC529 \uB2E4\uAC00\uC62C \uAC70\uC608\uC694.
    \uB4F1\uB300 \uBE5B\uC73C\uB85C \uC774 \uC544\uB798\uAE4C\uC9C0 \uBD88\uB7EC
    \uBD10\uC694."
  sendThreeLine: "\uC55E\uC5D0 \uC788\uB294 \uC190\uC7A1\uC774\uB97C \uD55C \uBC88
    \uB204\uB97C \uB54C\uB9C8\uB2E4 \uB4F1\uB300 \uBE5B\uC774 \uD55C \uBC88 \uB098\uAC00\uC694.
    \uBA3C\uC800 \uC138 \uBC88 \uBCF4\uB0B4 \uBCF4\uC138\uC694."
  retryLine: "\uBA87 \uBC88 \uBCF4\uB0C8\uB294\uC9C0 \uC138\uBA74\uC11C \uB2E4\uC2DC
    \uD574 \uBCFC\uAE4C\uC694? \uC138 \uBC88\uC774\uC5D0\uC694."
  answeredLine: "\uB300\uB2F5\uD588\uC5B4\uC694! \uC138 \uBC88 \u2014 1,000m \uC5D0\uC11C
    {name}\uC774 \uD558\uB358 \uBC14\uB85C \uADF8 \uB9D0\uC774\uC5D0\uC694. \uBD10\uC694,
    \uC870\uAE08 \uB2E4\uAC00\uC640\uC694."
  seaFirstLine: "\uC774\uBC88\uC5D4 {name}\uC774 \uBA3C\uC800 \uBCF4\uB0B4\uC694.
    \uBA87 \uBC88 \uAE5C\uBE61\uC774\uB294\uC9C0 \uC138\uC5B4 \uBCF4\uACE0, \uAC19\uC740
    \uC218\uB9CC\uD07C \uB300\uB2F5\uD574 \uC8FC\uC138\uC694."
  seaRetryLine: "\uB2E4\uC2DC \uD55C \uBC88 \uBCF4\uB0BC\uAC8C\uC694. \uC798 \uC138\uC5B4
    \uBCF4\uC138\uC694."
  goodLine: "\uB9DE\uC544\uC694! \uB610 \uB2E4\uAC00\uC640\uC694."
  goDownLine: "\uB4F1\uB300 \uBC14\uB85C \uC544\uB798\uAE4C\uC9C0 \uC654\uC5B4\uC694.
    \uBC14\uB2F7\uAC00\uB85C \uB0B4\uB824\uAC00 \uAC00\uAE4C\uC774\uC11C \uB9CC\uB098
    \uBD10\uC694."
  nearLine: "\uBC14\uB85C \uC55E\uC774\uC5D0\uC694. \uC624\uB298 \uBC24 1,000m \uC5D0\uC11C
    \uB9CC\uB09C \u2014 \uBC14\uB85C \uADF8 \uBAA8\uC2B5\uC774\uC8E0?"
  finaleLine: "\uADF8\uB9AC\uACE0\u2026 \uBCF4\uC138\uC694, \uBC14\uB2E4 \uACF3\uACF3\uC5D0\uC11C
    \uD478\uB978 \uBE5B\uC774 \uCF1C\uC838\uC694. \uC624\uB298 \uBC24 \uD568\uAED8
    \uC62C\uB77C\uC628 \uBB34\uB9AC\uC608\uC694. \uB4F1\uB300\uC9C0\uAE30\uB3C4,
    \uC120\uC7A5\uB2D8\uB3C4, \uC624\uB298 \uBC24\uC758 \uC6B0\uB9AC\uB3C4 \uD63C\uC790\uAC00
    \uC544\uB2C8\uC5C8\uC5B4\uC694."
  outroLine: "\uD574\uAC00 \uB728\uAE30 \uC804\uC5D0 \uB2E4\uC2DC \uAE4A\uC740 \uBC14\uB2E4\uB85C
    \uB0B4\uB824\uAC00\uACA0\uC8E0. \uC774\uC81C \uAD00\uCE21\uC18C\uB85C \uB3CC\uC544\uAC00\uC694."
