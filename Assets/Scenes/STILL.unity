  whaleFall: {fileID: 1077586669}
  oarfish: {fileID: 1057901512}
  oarfishChance: 0.6
  oarfishAfter: 75
  oarfishLine: "\u2026{0} \uBCF4\uC138\uC694! \uC138\uB85C\uB85C \uC11C \uC788\uB294
    \uC740\uBE5B \uAE34 \uBB3C\uACE0\uAE30 \u2014 \uC0B0\uAC08\uCE58\uC608\uC694.
    \uBF08 \uC788\uB294 \uBB3C\uACE0\uAE30 \uC911 \uAC00\uC7A5 \uAE38\uAC8C \uC790\uB77C\uC694.
    \uBA38\uB9AC\uB97C \uC704\uB85C \uD558\uACE0 \uBD89\uC740 \uB4F1\uC9C0\uB290\uB7EC\uBBF8\uB97C
    \uBB3C\uACB0\uCC98\uB7FC \uD754\uB4E4\uBA70 \uD5E4\uC5C4\uCCD0\uC694. \uC0B4\uC544
    \uC788\uB294 \uBAA8\uC2B5\uC744 \uBCF8 \uC0AC\uB78C\uC740 \uC544\uC8FC \uB4DC\uBB3C\uC5B4\uC694."
  nightWhale: {fileID: 1775497933}
  watchLine: "\uB05D\uAE4C\uC9C0 \uB180\uB77C\uAC8C \uD558\uC9C0 \uC54A\uACE0 \uC9C0\uCF1C\uBD10
    \uC92C\uC5B4\uC694. \uC788\uB294 \uADF8\uB300\uB85C\uC758 \uBAA8\uC2B5\uC73C\uB85C
    \uAE30\uB85D\uD588\uC5B4\uC694."
